@model KhalawanyTube.ViewModels.LoginViewModel

<div class="form-wrap">
    <div class="form-card">
        <div class="form-logo">
            <div class="logo-icon">▶</div>
            <h2>Welcome back</h2>
            <p>Sign in to your family account</p>
        </div>

        <form method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;margin-top:4px;">Sign In</button>
        </form>

        <div class="form-footer">
            New to KhalawanyTube?
            <a asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
    </div>
</div>
