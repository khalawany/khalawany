@model KhalawanyTube.ViewModels.LoginViewModel
<div class="card">
    <h2>Login</h2>
    <form method="post">
        <div asp-validation-summary="All"></div>
        <label asp-for="Email"></label><input asp-for="Email" />
        <label asp-for="Password"></label><input asp-for="Password" type="password" />
        <button type="submit">Login</button>
    </form>
</div>
