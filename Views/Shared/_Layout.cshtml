<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KhalawanyTube</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<nav class="navbar">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-icon">▶</span>
        KhalawanyTube
    </a>

    <div class="navbar-links">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="nav-link" asp-controller="Media" asp-action="Upload">Upload</a>
            <a class="nav-link" asp-controller="Media" asp-action="MyClips">My Clips</a>
            <a class="nav-link" asp-controller="Profile" asp-action="Edit">Profile</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
            }
        }
    </div>

    <div class="navbar-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-sm">Sign in</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Join Family</a>
        }
    </div>
</nav>

<main>
    @RenderBody()
</main>

<script src="~/js/recorder.js" asp-append-version="true"></script>
</body>
</html>
