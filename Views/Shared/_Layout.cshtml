<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KhalawanyTube</title>
    <link rel="stylesheet" href="~/css/twitter-skin.css" />
</head>
<body>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" asp-controller="Home" asp-action="Index">KhalawanyTube</a>
        <nav class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Media" asp-action="Upload">Upload</a>
                <a asp-controller="Media" asp-action="MyClips">My Clips</a>
                <a asp-controller="Profile" asp-action="Edit">Profile</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index">Admin</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register">Register</a>
                <a asp-controller="Account" asp-action="Login">Login</a>
            }
        </nav>
    </div>
</header>

<main class="page">
    @RenderBody()
</main>

<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="~/js/react-feed.js"></script>
<script src="~/js/recorder.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
