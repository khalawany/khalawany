@model List<KhalawanyTube.Models.MediaClip>

<div class="container">
    <div class="hero">
        <h1>Your Family's <em>Private</em> Tube</h1>
        <p>Share videos and audio with everyone at home — no internet required.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🎬</div>
            <h3>Nothing here yet</h3>
            <p>Be the first to share something with the family!</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Media" asp-action="Upload" class="btn btn-primary btn-lg">Upload First Clip</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Join to Upload</a>
            }
        </div>
    }
    else
    {
        <div class="media-grid">
            @foreach (var clip in Model)
            {
                <div class="media-card">
                    <div class="media-thumb">
                        @if (clip.MediaType == "video")
                        {
                            <video src="@clip.FilePath" preload="metadata"></video>
                        }
                        else
                        {
                            <div class="audio-thumb">
                                <span class="audio-thumb-icon">🎵</span>
                            </div>
                        }
                        <div class="thumb-badges">
                            <span class="badge badge-@clip.MediaType">@clip.MediaType</span>
                        </div>
                        @if (clip.IsShared)
                        {
                            <span class="badge badge-shared thumb-badge-shared">shared</span>
                        }
                    </div>

                    <div class="media-player">
                        @if (clip.MediaType == "video")
                        {
                            <video src="@clip.FilePath" controls preload="none"></video>
                        }
                        else
                        {
                            <audio src="@clip.FilePath" controls></audio>
                        }
                    </div>

                    <div class="media-card-body">
                        <div class="media-card-title" title="@clip.Title">@clip.Title</div>
                        @if (!string.IsNullOrWhiteSpace(clip.Description))
                        {
                            <div class="media-card-desc">@clip.Description</div>
                        }
                        <div class="media-card-meta">
                            <span class="author">@(clip.Owner?.DisplayName ?? "Family")</span>
                            <span>@clip.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                    <div class="media-card-actions">
                        <a asp-controller="Media" asp-action="Watch" asp-route-id="@clip.Id"
                           class="btn btn-secondary btn-sm" style="flex:1;">💬 Comments &amp; Likes</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
